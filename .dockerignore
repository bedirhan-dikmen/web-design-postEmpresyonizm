# Build context for the Dockerfile. Everything `npm run build` needs stays in:
# app/ components/ lib/ public/ package*.json next.config.ts postcss.config.mjs tsconfig.json

# dependencies and build output (rebuilt inside the image)
node_modules
.next
out
*.tsbuildinfo
next-env.d.ts

# git, editors, OS
.git
.gitignore
.gitattributes
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# environment files: NEXT_PUBLIC_* values reach the build only as compose build args
.env
.env.*
!.env.example

# logs, test and scratch output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
coverage
.vercel
.verify
scratchpad
tmp
temp

# not needed at build or runtime: art sources and generators, docs, deployment files
art-src
scripts
*.md
public/prototype-assets/README.md
public/prototype-assets/_placeholder
Dockerfile
.dockerignore
docker-compose*.yml
compose*.yml
