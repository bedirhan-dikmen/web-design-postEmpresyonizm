# Kerinti Soft website — deployment settings. Copy to .env (never commit .env) and fill in.
#
# Everything starting with NEXT_PUBLIC_ is PUBLIC: it is baked into the page and the browser bundle when the
# image is built. Never put a password, token or API key here. After changing a value, rebuild:
#   docker compose up -d --build
# An empty value means "not published": the site shows nothing for it (never a made-up value).

# Host port the site is published on (container port is always 3020). Cloudflare Tunnel points here.
APP_PORT=3020

# Canonical origin, no trailing slash. The final QR encodes <this>/#iletisim.
# Leave empty to use lib/site/site.json → url (https://kerinti.com.tr). Set it only for another host, e.g. staging.
NEXT_PUBLIC_SITE_URL=

# Contact channels shown in the contact section and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
# e.g. +90 212 000 00 00 (shown as written; the tel: link keeps only digits and +)
NEXT_PUBLIC_CONTACT_PHONE=
# address lines separated by |   e.g. Örnek Mah. Örnek Cad. No: 1 | 34000 Kadıköy / İstanbul
NEXT_PUBLIC_CONTACT_ADDRESS=

# HTTPS endpoint the contact form POSTs JSON to { name, company, phone, email, topic, message, consent }; it must
# answer 2xx on success. PUBLIC (the browser calls it directly) — use a form service URL, not a secret API key.
# Empty: the form is shown but says online sending is not active, and nothing is sent.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
